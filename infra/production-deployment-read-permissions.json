{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "acm:DescribeCertificate",
      "Resource": "arn:aws:acm:ap-southeast-1:402365884836:certificate/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:ResourceTag/Project": "RepurposePro",
          "aws:ResourceTag/Environment": "production"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "acm:DescribeCertificate",
      "Resource": "arn:aws:acm:ap-southeast-1:402365884836:certificate/3c1de807-4439-45f1-b4a2-8f64460a5475",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-southeast-1" }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudformation:DescribeEvents",
      "Resource": [
        "arn:aws:cloudformation:ap-southeast-1:402365884836:stack/RepurposePro-Production-*/*",
        "arn:aws:cloudformation:ap-southeast-1:402365884836:changeSet/production-*/*"
      ],
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-southeast-1" }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["logs:DescribeLogStreams", "logs:GetLogEvents", "logs:FilterLogEvents"],
      "Resource": [
        "arn:aws:logs:ap-southeast-1:402365884836:log-group:/repurposepro/production/api:*",
        "arn:aws:logs:ap-southeast-1:402365884836:log-group:/repurposepro/production/worker:*"
      ],
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-southeast-1" }
      }
    }
  ]
}
