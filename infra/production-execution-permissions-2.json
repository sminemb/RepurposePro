{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-1:402365884836:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "RepurposePro",
          "aws:ResourceTag/Environment": "production"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["elasticloadbalancing:CreateLoadBalancer", "elasticloadbalancing:AddTags"],
      "Resource": [
        "arn:aws:elasticloadbalancing:ap-southeast-1:402365884836:loadbalancer/app/repurposepro-production-*/*",
        "arn:aws:elasticloadbalancing:ap-southeast-1:402365884836:targetgroup/repurposepro-production-*/*",
        "arn:aws:elasticloadbalancing:ap-southeast-1:402365884836:listener/app/repurposepro-production-*/*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "RepurposePro",
          "aws:RequestTag/Environment": "production"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DeleteLoadBalancer",
        "elasticloadbalancing:DeleteTargetGroup",
        "elasticloadbalancing:DeleteListener",
        "elasticloadbalancing:ModifyLoadBalancerAttributes",
        "elasticloadbalancing:ModifyTargetGroup",
        "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:AddTags",
        "elasticloadbalancing:RemoveTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:ResourceTag/Project": "RepurposePro",
          "aws:ResourceTag/Environment": "production"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "elasticfilesystem:CreateFileSystem",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "RepurposePro",
          "aws:RequestTag/Environment": "production"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:402365884836:log-group:/repurposepro/production/*"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::402365884836:role/RepurposeProApiTaskRole",
        "arn:aws:iam::402365884836:role/RepurposeProWorkerTaskRole",
        "arn:aws:iam::402365884836:role/RepurposeProEcsExecutionRole",
        "arn:aws:iam::402365884836:role/RepurposeProProductionEcsExecutionRole"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "elasticloadbalancing:CreateTargetGroup",
      "Resource": "arn:aws:elasticloadbalancing:ap-southeast-1:402365884836:targetgroup/repurposepro-production-api/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:CreateSubnet", "ec2:CreateRouteTable", "ec2:CreateSecurityGroup"],
      "Resource": [
        "arn:aws:ec2:ap-southeast-1:402365884836:security-group/*",
        "arn:aws:ec2:ap-southeast-1:402365884836:subnet/*",
        "arn:aws:ec2:ap-southeast-1:402365884836:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "RepurposePro",
          "aws:RequestTag/Environment": "production"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ap-southeast-1:402365884836:security-group/*",
        "arn:aws:ec2:ap-southeast-1:402365884836:subnet/*",
        "arn:aws:ec2:ap-southeast-1:402365884836:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "RepurposePro",
          "aws:RequestTag/Environment": "production",
          "ec2:CreateAction": ["CreateSecurityGroup", "CreateSubnet", "CreateRouteTable"]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "secretsmanager:CreateSecret",
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:402365884836:secret:repurposepro/production/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "RepurposePro",
          "aws:RequestTag/Environment": "production",
          "secretsmanager:Name": [
            "repurposepro/production/REDIS_URL",
            "repurposepro/production/BETTER_AUTH_SECRET",
            "repurposepro/production/ARCJET_KEY",
            "repurposepro/production/GEMINI_API_KEY",
            "repurposepro/production/STRIPE_SECRET_KEY",
            "repurposepro/production/STRIPE_WEBHOOK_SECRET",
            "repurposepro/production/DATABASE_URL",
            "repurposepro/production/DATABASE_CHECKOUT_URL",
            "repurposepro/production/DATABASE_WEBHOOK_URL",
            "repurposepro/production/DATABASE_PROCESSING_URL",
            "repurposepro/production/DATABASE_ADMIN_URL"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["secretsmanager:DescribeSecret", "secretsmanager:TagResource"],
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:402365884836:secret:repurposepro/production/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "acm:ListTagsForCertificate",
        "acm:AddTagsToCertificate"
      ],
      "Resource": "arn:aws:acm:ap-southeast-1:402365884836:certificate/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:ResourceTag/Project": "RepurposePro",
          "aws:ResourceTag/Environment": "production"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "acm:DescribeCertificate",
      "Resource": "arn:aws:acm:ap-southeast-1:402365884836:certificate/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::402365884836:role/RepurposeProProductionEcsExecutionRole"
    }
  ]
}
