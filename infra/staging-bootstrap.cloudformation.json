    "ApiCertificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "DomainName": "api-staging.re-purpose.pro",
        "ValidationMethod": "DNS",
        "KeyAlgorithm": "RSA_2048",
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      }
    }
  },
  "Outputs": {
    "ArnARCJETKEY": {
      "Description": "Secret ARN for ECS runtime injection",
      "Value": {
        "Ref": "SecretARCJETKEY"
      }
    },
    "ArnGEMINIAPIKEY": {
      "Description": "Secret ARN for ECS runtime injection",
      "Value": {
        "Ref": "SecretGEMINIAPIKEY"
      }
    },
    "ArnSTRIPESECRETKEY": {
      "Description": "Secret ARN for ECS runtime injection",
