    },
    "ArnDATABASEADMINURL": {
      "Description": "Secret ARN for ECS runtime injection",
      "Value": {
        "Ref": "SecretDATABASEADMINURL"
      }
    },
    "ApiCertificateArn": {
      "Description": "Singapore API certificate ARN",
      "Value": {
