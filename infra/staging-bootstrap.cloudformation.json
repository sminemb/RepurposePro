        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      }
    },
    "SecretDATABASECHECKOUTURL": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "repurposepro/staging/DATABASE_CHECKOUT_URL",
        "Description": "RepurposePro staging DATABASE_CHECKOUT_URL",
        "SecretString": {
          "Ref": "ValueDATABASECHECKOUTURL"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      }
    },
    "SecretDATABASEWEBHOOKURL": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "repurposepro/staging/DATABASE_WEBHOOK_URL",
        "Description": "RepurposePro staging DATABASE_WEBHOOK_URL",
        "SecretString": {
          "Ref": "ValueDATABASEWEBHOOKURL"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      }
    },
    "SecretDATABASEPROCESSINGURL": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "repurposepro/staging/DATABASE_PROCESSING_URL",
        "Description": "RepurposePro staging DATABASE_PROCESSING_URL",
        "SecretString": {
