    "ArnARCJETKEY": {
      "Description": "Secret ARN for ECS runtime injection",
      "Value": {
        "Ref": "SecretARCJETKEY"
      }
    },
    "ArnGEMINIAPIKEY": {
      "Description": "Secret ARN for ECS runtime injection",
      "Value": {
        "Ref": "SecretGEMINIAPIKEY"
      }
    },
    "ArnSTRIPESECRETKEY": {
      "Description": "Secret ARN for ECS runtime injection",
      "Value": {
        "Ref": "SecretSTRIPESECRETKEY"
      }
    },
    "ArnSTRIPEWEBHOOKSECRET": {
      "Description": "Secret ARN for ECS runtime injection",
      "Value": {
        "Ref": "SecretSTRIPEWEBHOOKSECRET"
      }
    },
    "ArnDATABASEURL": {
      "Description": "Secret ARN for ECS runtime injection",
      "Value": {
        "Ref": "SecretDATABASEURL"
      }
    },
    "ArnDATABASECHECKOUTURL": {
      "Description": "Secret ARN for ECS runtime injection",
      "Value": {
        "Ref": "SecretDATABASECHECKOUTURL"
      }
    },
    "ArnDATABASEWEBHOOKURL": {
      "Description": "Secret ARN for ECS runtime injection",
      "Value": {
        "Ref": "SecretDATABASEWEBHOOKURL"
      }
