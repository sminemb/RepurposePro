{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "RepurposePro isolated production configuration secrets. Stripe remains sandbox-only; all secrets are retained.",
  "Parameters": {
    "ValueARCJETKEY": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "Description": "Private production value for ARCJET_KEY"
    },
    "ValueGEMINIAPIKEY": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "Description": "Private production value for GEMINI_API_KEY"
    },
    "ValueSTRIPESECRETKEY": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "Description": "Private production value for STRIPE_SECRET_KEY"
    },
    "ValueSTRIPEWEBHOOKSECRET": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "Description": "Private production value for STRIPE_WEBHOOK_SECRET"
    },
    "ValueDATABASEURL": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "Description": "Private production value for DATABASE_URL"
    },
    "ValueDATABASECHECKOUTURL": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "Description": "Private production value for DATABASE_CHECKOUT_URL"
    },
    "ValueDATABASEWEBHOOKURL": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "Description": "Private production value for DATABASE_WEBHOOK_URL"
    },
    "ValueDATABASEPROCESSINGURL": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "Description": "Private production value for DATABASE_PROCESSING_URL"
    },
    "ValueDATABASEADMINURL": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 1,
      "Description": "Private production value for DATABASE_ADMIN_URL"
    }
  },
  "Resources": {
    "SecretARCJETKEY": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "repurposepro/production/ARCJET_KEY",
        "Description": "RepurposePro production ARCJET_KEY",
        "SecretString": {
          "Ref": "ValueARCJETKEY"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "SecretGEMINIAPIKEY": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "repurposepro/production/GEMINI_API_KEY",
        "Description": "RepurposePro production GEMINI_API_KEY",
        "SecretString": {
          "Ref": "ValueGEMINIAPIKEY"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "SecretSTRIPESECRETKEY": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "repurposepro/production/STRIPE_SECRET_KEY",
        "Description": "RepurposePro production STRIPE_SECRET_KEY",
        "SecretString": {
          "Ref": "ValueSTRIPESECRETKEY"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "SecretSTRIPEWEBHOOKSECRET": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "repurposepro/production/STRIPE_WEBHOOK_SECRET",
        "Description": "RepurposePro production STRIPE_WEBHOOK_SECRET",
        "SecretString": {
          "Ref": "ValueSTRIPEWEBHOOKSECRET"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "production"
