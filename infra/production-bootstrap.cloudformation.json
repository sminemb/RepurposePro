        "Description": "RepurposePro production DATABASE_ADMIN_URL",
        "SecretString": {
          "Ref": "ValueDATABASEADMINURL"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
