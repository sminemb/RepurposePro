        "Description": "RepurposePro production DATABASE_WEBHOOK_URL",
        "SecretString": {
          "Ref": "ValueDATABASEWEBHOOKURL"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      }
    },
    "SecretDATABASEPROCESSINGURL": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "repurposepro/production/DATABASE_PROCESSING_URL",
        "Description": "RepurposePro production DATABASE_PROCESSING_URL",
        "SecretString": {
          "Ref": "ValueDATABASEPROCESSINGURL"
        },
        "Tags": [
          {
            "Key": "Project",
