{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "elasticloadbalancing:Describe*",
        "ecs:Describe*",
        "elasticfilesystem:Describe*",
        "logs:DescribeLogGroups",
        "ec2:DescribeAccountAttributes",
        "elasticache:DescribeReplicationGroups",
        "elasticache:DescribeCacheClusters",
        "elasticache:DescribeCacheSubnetGroups",
        "elasticache:DescribeCacheParameterGroups",
        "elasticache:DescribeCacheParameters",
        "elasticache:DescribeCacheEngineVersions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-1:402365884836:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "RepurposePro",
          "aws:ResourceTag/Environment": "staging"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["elasticloadbalancing:CreateLoadBalancer", "elasticloadbalancing:AddTags"],
      "Resource": [
        "arn:aws:elasticloadbalancing:ap-southeast-1:402365884836:loadbalancer/app/repurposepro-staging-*/*",
        "arn:aws:elasticloadbalancing:ap-southeast-1:402365884836:targetgroup/repurposepro-staging-*/*",
        "arn:aws:elasticloadbalancing:ap-southeast-1:402365884836:listener/app/repurposepro-staging-*/*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "RepurposePro",
          "aws:RequestTag/Environment": "staging"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["elasticloadbalancing:CreateListener", "elasticloadbalancing:ModifyListener"],
      "Resource": [
        "arn:aws:elasticloadbalancing:ap-southeast-1:402365884836:loadbalancer/app/repurposepro-staging-*/*",
        "arn:aws:elasticloadbalancing:ap-southeast-1:402365884836:listener/app/repurposepro-staging-*/*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DeleteLoadBalancer",
        "elasticloadbalancing:DeleteTargetGroup",
        "elasticloadbalancing:DeleteListener",
        "elasticloadbalancing:ModifyLoadBalancerAttributes",
        "elasticloadbalancing:ModifyTargetGroup",
        "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:AddTags",
        "elasticloadbalancing:RemoveTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:ResourceTag/Project": "RepurposePro",
          "aws:ResourceTag/Environment": "staging"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": [
        "arn:aws:ecs:ap-southeast-1:402365884836:cluster/repurposepro-staging",
        "arn:aws:ecs:ap-southeast-1:402365884836:service/repurposepro-staging/repurposepro-staging-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": "arn:aws:ecs:ap-southeast-1:402365884836:task-definition/repurposepro-staging-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "elasticfilesystem:CreateFileSystem",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "RepurposePro",
          "aws:RequestTag/Environment": "staging"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticfilesystem:DeleteFileSystem",
        "elasticfilesystem:CreateMountTarget",
        "elasticfilesystem:DeleteMountTarget",
        "elasticfilesystem:CreateAccessPoint",
        "elasticfilesystem:DeleteAccessPoint",
        "elasticfilesystem:PutLifecycleConfiguration",
        "elasticfilesystem:TagResource",
        "elasticfilesystem:UntagResource",
        "elasticfilesystem:PutBackupPolicy"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:ResourceTag/Project": "RepurposePro",
          "aws:ResourceTag/Environment": "staging"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:402365884836:log-group:/repurposepro/staging/*"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::402365884836:role/RepurposeProApiTaskRole",
        "arn:aws:iam::402365884836:role/RepurposeProWorkerTaskRole",
        "arn:aws:iam::402365884836:role/RepurposeProEcsExecutionRole"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "elasticloadbalancing.amazonaws.com",
            "ecs.amazonaws.com",
            "elasticache.amazonaws.com",
            "elasticfilesystem.amazonaws.com"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "elasticloadbalancing:CreateTargetGroup",
      "Resource": "arn:aws:elasticloadbalancing:ap-southeast-1:402365884836:targetgroup/repurposepro-staging-api/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:CreateSubnet", "ec2:CreateRouteTable", "ec2:CreateSecurityGroup"],
      "Resource": "arn:aws:ec2:ap-southeast-1:402365884836:vpc/vpc-0c53f5864c38d570a",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:CreateSubnet", "ec2:CreateRouteTable", "ec2:CreateSecurityGroup"],
      "Resource": [
        "arn:aws:ec2:ap-southeast-1:402365884836:security-group/*",
        "arn:aws:ec2:ap-southeast-1:402365884836:subnet/*",
        "arn:aws:ec2:ap-southeast-1:402365884836:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "RepurposePro",
          "aws:RequestTag/Environment": "staging"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSubnet",
        "ec2:DeleteRouteTable",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-1:402365884836:subnet/*",
        "arn:aws:ec2:ap-southeast-1:402365884836:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:ResourceTag/Project": "RepurposePro",
          "aws:ResourceTag/Environment": "staging"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ap-southeast-1:402365884836:security-group/*",
        "arn:aws:ec2:ap-southeast-1:402365884836:subnet/*",
        "arn:aws:ec2:ap-southeast-1:402365884836:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "RepurposePro",
          "aws:RequestTag/Environment": "staging",
          "ec2:CreateAction": ["CreateSecurityGroup", "CreateSubnet", "CreateRouteTable"]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticache:CreateReplicationGroup",
        "elasticache:ModifyReplicationGroup",
        "elasticache:DeleteReplicationGroup",
        "elasticache:CreateCacheCluster",
        "elasticache:DeleteCacheCluster",
        "elasticache:CreateCacheSubnetGroup",
        "elasticache:ModifyCacheSubnetGroup",
        "elasticache:DeleteCacheSubnetGroup",
        "elasticache:AddTagsToResource",
        "elasticache:RemoveTagsFromResource",
        "elasticache:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:elasticache:ap-southeast-1:402365884836:replicationgroup:repurposepro-staging-*",
        "arn:aws:elasticache:ap-southeast-1:402365884836:cluster:repurposepro-staging-*",
        "arn:aws:elasticache:ap-southeast-1:402365884836:subnetgroup:repurposepro-staging-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "secretsmanager:CreateSecret",
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:402365884836:secret:repurposepro/staging/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "RepurposePro",
          "aws:RequestTag/Environment": "staging",
          "secretsmanager:Name": [
            "repurposepro/staging/REDIS_URL",
            "repurposepro/staging/BETTER_AUTH_SECRET",
            "repurposepro/staging/ARCJET_KEY",
            "repurposepro/staging/GEMINI_API_KEY",
            "repurposepro/staging/STRIPE_SECRET_KEY",
            "repurposepro/staging/STRIPE_WEBHOOK_SECRET",
            "repurposepro/staging/DATABASE_URL",
            "repurposepro/staging/DATABASE_CHECKOUT_URL",
            "repurposepro/staging/DATABASE_WEBHOOK_URL",
            "repurposepro/staging/DATABASE_PROCESSING_URL",
            "repurposepro/staging/DATABASE_ADMIN_URL"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["elasticache:CreateCacheParameterGroup", "elasticache:AddTagsToResource"],
      "Resource": "arn:aws:elasticache:ap-southeast-1:402365884836:parametergroup:repurp-cache-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "RepurposePro",
          "aws:RequestTag/Environment": "staging"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticache:CreateReplicationGroup",
        "elasticache:ModifyCacheParameterGroup",
        "elasticache:DeleteCacheParameterGroup",
        "elasticache:AddTagsToResource",
        "elasticache:RemoveTagsFromResource",
        "elasticache:ListTagsForResource"
      ],
      "Resource": "arn:aws:elasticache:ap-southeast-1:402365884836:parametergroup:repurp-cache-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:ResourceTag/Project": "RepurposePro",
          "aws:ResourceTag/Environment": "staging"
        }
      }
    }
  ]
}
