{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "elasticloadbalancing:Describe*",
        "ecs:Describe*",
        "elasticfilesystem:Describe*",
        "logs:DescribeLogGroups",
        "ec2:DescribeAccountAttributes",
        "elasticache:DescribeReplicationGroups",
        "elasticache:DescribeCacheClusters",
        "elasticache:DescribeCacheSubnetGroups",
        "elasticache:DescribeCacheParameterGroups",
        "elasticache:DescribeCacheParameters",
        "elasticache:DescribeCacheEngineVersions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["elasticloadbalancing:CreateListener", "elasticloadbalancing:ModifyListener"],
      "Resource": [
        "arn:aws:elasticloadbalancing:ap-southeast-1:402365884836:loadbalancer/app/repurposepro-production-*/*",
        "arn:aws:elasticloadbalancing:ap-southeast-1:402365884836:listener/app/repurposepro-production-*/*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:CreateService",
        "ecs:UpdateService",
        "ecs:DeleteService",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": [
        "arn:aws:ecs:ap-southeast-1:402365884836:cluster/repurposepro-production",
        "arn:aws:ecs:ap-southeast-1:402365884836:service/repurposepro-production/repurposepro-production-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": "arn:aws:ecs:ap-southeast-1:402365884836:task-definition/repurposepro-production-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticfilesystem:DeleteFileSystem",
        "elasticfilesystem:CreateMountTarget",
        "elasticfilesystem:DeleteMountTarget",
        "elasticfilesystem:CreateAccessPoint",
        "elasticfilesystem:DeleteAccessPoint",
        "elasticfilesystem:PutLifecycleConfiguration",
        "elasticfilesystem:TagResource",
        "elasticfilesystem:UntagResource",
        "elasticfilesystem:PutBackupPolicy"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:ResourceTag/Project": "RepurposePro",
          "aws:ResourceTag/Environment": "production"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "elasticloadbalancing.amazonaws.com",
            "ecs.amazonaws.com",
            "elasticache.amazonaws.com",
            "elasticfilesystem.amazonaws.com"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:CreateSubnet", "ec2:CreateRouteTable", "ec2:CreateSecurityGroup"],
      "Resource": "arn:aws:ec2:ap-southeast-1:402365884836:vpc/vpc-0c53f5864c38d570a",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSubnet",
        "ec2:DeleteRouteTable",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": [
        "arn:aws:ec2:ap-southeast-1:402365884836:subnet/*",
        "arn:aws:ec2:ap-southeast-1:402365884836:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:ResourceTag/Project": "RepurposePro",
          "aws:ResourceTag/Environment": "production"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticache:CreateReplicationGroup",
        "elasticache:ModifyReplicationGroup",
        "elasticache:DeleteReplicationGroup",
        "elasticache:CreateCacheCluster",
        "elasticache:DeleteCacheCluster",
        "elasticache:CreateCacheSubnetGroup",
        "elasticache:ModifyCacheSubnetGroup",
        "elasticache:DeleteCacheSubnetGroup",
        "elasticache:AddTagsToResource",
        "elasticache:RemoveTagsFromResource",
        "elasticache:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:elasticache:ap-southeast-1:402365884836:replicationgroup:repurposepro-production-*",
        "arn:aws:elasticache:ap-southeast-1:402365884836:cluster:repurposepro-production-*",
        "arn:aws:elasticache:ap-southeast-1:402365884836:subnetgroup:repurposepro-production-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["elasticache:CreateCacheParameterGroup", "elasticache:AddTagsToResource"],
      "Resource": "arn:aws:elasticache:ap-southeast-1:402365884836:parametergroup:repurp-cache-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:RequestTag/Project": "RepurposePro",
          "aws:RequestTag/Environment": "production"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticache:CreateReplicationGroup",
        "elasticache:ModifyCacheParameterGroup",
        "elasticache:DeleteCacheParameterGroup",
        "elasticache:AddTagsToResource",
        "elasticache:RemoveTagsFromResource",
        "elasticache:ListTagsForResource"
      ],
      "Resource": "arn:aws:elasticache:ap-southeast-1:402365884836:parametergroup:repurp-cache-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "aws:ResourceTag/Project": "RepurposePro",
          "aws:ResourceTag/Environment": "production"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "acm:RequestCertificate",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "acm:ValidationMethod": "DNS"
        },
        "ForAllValues:StringEquals": {
          "acm:DomainNames": ["api.re-purpose.pro"]
        },
        "Null": {
          "acm:DomainNames": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:DeleteCluster",
        "ecs:UpdateClusterSettings",
        "ecs:TagResource",
        "ecs:UntagResource"
      ],
      "Resource": "arn:aws:ecs:ap-southeast-1:402365884836:cluster/repurposepro-production",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    }
  ]
}
