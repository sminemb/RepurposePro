{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "RepurposePro staging API, worker, encrypted shared files, and private Redis-compatible queue.",
  "Parameters": {
    "NamePrefix": {
      "Type": "String",
      "Default": "repurposepro-staging",
      "AllowedValues": ["repurposepro-staging"]
    },
    "ClusterName": {
      "Type": "String",
      "Default": "repurposepro-staging",
      "AllowedValues": ["repurposepro-staging"]
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id",
      "AllowedValues": ["vpc-0c53f5864c38d570a"]
    },
    "PublicSubnetA": {
      "Type": "AWS::EC2::Subnet::Id",
      "AllowedValues": ["subnet-04ccf2a9fbbfe5142"]
    },
    "PublicSubnetB": {
      "Type": "AWS::EC2::Subnet::Id",
      "AllowedValues": ["subnet-029ac42b248e4cd3d"]
    },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:acm:ap-southeast-1:402365884836:certificate/[a-f0-9-]+"
    },
    "ApiImage": {
      "Type": "String",
      "AllowedPattern": "402365884836[.]dkr[.]ecr[.]ap-southeast-1[.]amazonaws[.]com/repurposepro-staging-api@sha256:[a-f0-9]{64}"
    },
    "WorkerImage": {
      "Type": "String",
      "AllowedPattern": "402365884836[.]dkr[.]ecr[.]ap-southeast-1[.]amazonaws[.]com/repurposepro-staging-worker@sha256:[a-f0-9]{64}"
    },
    "AppUrl": {
      "Type": "String",
      "Default": "https://staging.re-purpose.pro",
      "AllowedValues": ["https://staging.re-purpose.pro"]
    },
    "AdminEmail": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 3
    },
    "BetterAuthSecretValue": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 32
    },
    "RedisPassword": {
      "Type": "String",
      "NoEcho": true,
      "AllowedPattern": "[a-f0-9]{64}"
    },
    "StripeStarterPriceId": {
      "Type": "String",
      "AllowedPattern": "price_[A-Za-z0-9]+"
    },
    "StripeCreatorPriceId": {
      "Type": "String",
      "AllowedPattern": "price_[A-Za-z0-9]+"
    },
    "StripeProPriceId": {
      "Type": "String",
      "AllowedPattern": "price_[A-Za-z0-9]+"
    },
    "ArnARCJETKEY": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:ap-southeast-1:402365884836:secret:repurposepro/staging/ARCJET_KEY-[A-Za-z0-9]{6}"
    },
    "ArnGEMINIAPIKEY": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:ap-southeast-1:402365884836:secret:repurposepro/staging/GEMINI_API_KEY-[A-Za-z0-9]{6}"
    },
    "ArnSTRIPESECRETKEY": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:ap-southeast-1:402365884836:secret:repurposepro/staging/STRIPE_SECRET_KEY-[A-Za-z0-9]{6}"
    },
    "ArnSTRIPEWEBHOOKSECRET": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:ap-southeast-1:402365884836:secret:repurposepro/staging/STRIPE_WEBHOOK_SECRET-[A-Za-z0-9]{6}"
    },
    "ArnDATABASEURL": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:ap-southeast-1:402365884836:secret:repurposepro/staging/DATABASE_URL-[A-Za-z0-9]{6}"
    },
    "ArnDATABASECHECKOUTURL": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:ap-southeast-1:402365884836:secret:repurposepro/staging/DATABASE_CHECKOUT_URL-[A-Za-z0-9]{6}"
    },
    "ArnDATABASEWEBHOOKURL": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:ap-southeast-1:402365884836:secret:repurposepro/staging/DATABASE_WEBHOOK_URL-[A-Za-z0-9]{6}"
    },
    "ArnDATABASEPROCESSINGURL": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:ap-southeast-1:402365884836:secret:repurposepro/staging/DATABASE_PROCESSING_URL-[A-Za-z0-9]{6}"
    },
    "ArnDATABASEADMINURL": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:ap-southeast-1:402365884836:secret:repurposepro/staging/DATABASE_ADMIN_URL-[A-Za-z0-9]{6}"
    }
  },
  "Resources": {
    "PrivateSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "AvailabilityZone": "ap-southeast-1a",
        "CidrBlock": "172.31.48.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      }
    },
    "PrivateSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "AvailabilityZone": "ap-southeast-1b",
        "CidrBlock": "172.31.49.0/24",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      }
    },
    "PrivateRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      }
    },
    "PrivateRouteAssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateSubnetA"
        },
        "RouteTableId": {
          "Ref": "PrivateRouteTable"
        }
      }
    },
    "PrivateRouteAssociationB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateSubnetB"
        },
        "RouteTableId": {
          "Ref": "PrivateRouteTable"
        }
      }
    },
    "TaskSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Staging API and worker; inbound API only from load balancer",
        "VpcId": {
          "Ref": "VpcId"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "Outbound staging TCP 443"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "CidrIp": "0.0.0.0/0",
            "Description": "Outbound staging TCP 5432"
          }
        ]
      }
    },
    "LoadBalancerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Public HTTPS staging API",
        "VpcId": {
          "Ref": "VpcId"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ],
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "Inbound staging TCP 443"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0",
            "Description": "Inbound staging TCP 80"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 4000,
            "ToPort": 4000,
            "DestinationSecurityGroupId": {
              "Ref": "TaskSecurityGroup"
            },
            "Description": "Outbound staging TCP 4000"
          }
        ]
      }
    },
    "StorageSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Encrypted NFS only from staging tasks",
        "VpcId": {
          "Ref": "VpcId"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ],
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 2049,
            "ToPort": 2049,
            "SourceSecurityGroupId": {
              "Ref": "TaskSecurityGroup"
            },
            "Description": "Inbound staging TCP 2049"
          }
        ]
      }
    },
    "CacheSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private TLS cache only from staging tasks",
        "VpcId": {
          "Ref": "VpcId"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ],
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 6379,
            "ToPort": 6379,
            "SourceSecurityGroupId": {
              "Ref": "TaskSecurityGroup"
            },
            "Description": "Inbound staging TCP 6379"
          }
        ]
      }
    },
    "ApiIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "TaskSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 4000,
        "ToPort": 4000,
        "SourceSecurityGroupId": {
          "Ref": "LoadBalancerSecurityGroup"
        },
        "Description": "Staging service connection on TCP 4000"
      }
    },
    "StorageEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Ref": "TaskSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 2049,
        "ToPort": 2049,
        "DestinationSecurityGroupId": {
          "Ref": "StorageSecurityGroup"
        },
        "Description": "Staging service connection on TCP 2049"
      }
    },
    "CacheEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Ref": "TaskSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 6379,
        "ToPort": 6379,
        "DestinationSecurityGroupId": {
          "Ref": "CacheSecurityGroup"
        },
        "Description": "Staging service connection on TCP 6379"
      }
    },
    "Storage": {
      "Type": "AWS::EFS::FileSystem",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Encrypted": true,
        "PerformanceMode": "generalPurpose",
        "ThroughputMode": "elastic",
        "FileSystemTags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ],
        "BackupPolicy": {
          "Status": "ENABLED"
        }
      }
    },
    "StorageAccessPoint": {
      "Type": "AWS::EFS::AccessPoint",
      "Properties": {
        "FileSystemId": {
          "Ref": "Storage"
        },
        "PosixUser": {
          "Uid": "1000",
          "Gid": "1000"
        },
        "RootDirectory": {
          "Path": "/repurposepro-staging",
          "CreationInfo": {
            "OwnerUid": "1000",
            "OwnerGid": "1000",
            "Permissions": "0700"
          }
        },
        "AccessPointTags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      }
    },
    "StorageMountA": {
      "Type": "AWS::EFS::MountTarget",
      "Properties": {
        "FileSystemId": {
          "Ref": "Storage"
        },
        "SubnetId": {
          "Ref": "PrivateSubnetA"
        },
        "SecurityGroups": [
          {
            "Ref": "StorageSecurityGroup"
          }
        ]
      }
    },
    "StorageMountB": {
      "Type": "AWS::EFS::MountTarget",
      "Properties": {
        "FileSystemId": {
          "Ref": "Storage"
        },
        "SubnetId": {
          "Ref": "PrivateSubnetB"
        },
        "SecurityGroups": [
          {
            "Ref": "StorageSecurityGroup"
          }
        ]
      }
    },
    "CacheSubnetGroup": {
      "Type": "AWS::ElastiCache::SubnetGroup",
      "Properties": {
        "CacheSubnetGroupName": {
          "Fn::Sub": "${NamePrefix}-cache"
        },
        "Description": "Private RepurposePro staging queue",
        "SubnetIds": [
          {
            "Ref": "PrivateSubnetA"
          },
          {
            "Ref": "PrivateSubnetB"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "managed_by",
            "Value": "aws-skills"
          },
          {
            "Key": "skill",
            "Value": "elasticache"
          },
          {
            "Key": "skill_version",
            "Value": "1.0.0"
          },
          {
            "Key": "created_by",
            "Value": "elasticache-skill"
          },
          {
            "Key": "generation_model",
            "Value": "gpt-6"
          }
        ]
      }
    },
    "CacheParameters": {
      "Type": "AWS::ElastiCache::ParameterGroup",
      "Properties": {
        "CacheParameterGroupFamily": "valkey9",
        "Description": "Staging BullMQ queue must not evict jobs",
        "Properties": {
          "maxmemory-policy": "noeviction"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "managed_by",
            "Value": "aws-skills"
          },
          {
            "Key": "skill",
            "Value": "elasticache"
          },
          {
            "Key": "skill_version",
            "Value": "1.0.0"
          },
          {
            "Key": "created_by",
            "Value": "elasticache-skill"
          },
          {
            "Key": "generation_model",
            "Value": "gpt-6"
          }
        ]
      }
    },
    "Cache": {
      "Type": "AWS::ElastiCache::ReplicationGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "DependsOn": ["PrivateRouteAssociationA", "PrivateRouteAssociationB"],
      "Properties": {
        "ReplicationGroupId": {
          "Fn::Sub": "${NamePrefix}-queue"
        },
        "ReplicationGroupDescription": "RepurposePro staging queue; one node, daily backup, no automatic failover",
        "Engine": "valkey",
        "EngineVersion": "9.0",
        "CacheNodeType": "cache.t4g.micro",
        "CacheParameterGroupName": {
          "Ref": "CacheParameters"
        },
        "CacheSubnetGroupName": {
          "Ref": "CacheSubnetGroup"
        },
        "ClusterMode": "disabled",
        "NumCacheClusters": 1,
        "AutomaticFailoverEnabled": false,
        "MultiAZEnabled": false,
        "AtRestEncryptionEnabled": true,
        "TransitEncryptionEnabled": true,
        "TransitEncryptionMode": "required",
        "AuthToken": {
          "Ref": "RedisPassword"
        },
        "SecurityGroupIds": [
          {
            "Ref": "CacheSecurityGroup"
          }
        ],
        "SnapshotRetentionLimit": 1,
        "SnapshotWindow": "19:00-20:00",
        "AutoMinorVersionUpgrade": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "managed_by",
            "Value": "aws-skills"
          },
          {
            "Key": "skill",
            "Value": "elasticache"
          },
          {
            "Key": "skill_version",
            "Value": "1.0.0"
          },
          {
            "Key": "created_by",
            "Value": "elasticache-skill"
          },
          {
            "Key": "generation_model",
            "Value": "gpt-6"
          }
        ]
      }
    },
    "RedisConnectionSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "repurposepro/staging/REDIS_URL",
        "Description": "Private TLS staging queue connection",
        "SecretString": {
          "Fn::Sub": "rediss://:${RedisPassword}@${Cache.PrimaryEndPoint.Address}:6379"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      }
    },
    "BetterAuthSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "repurposepro/staging/BETTER_AUTH_SECRET",
        "Description": "Shared web and API staging session signature key",
        "SecretString": {
          "Ref": "BetterAuthSecretValue"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      }
    },
    "ApiLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "/repurposepro/staging/api",
        "RetentionInDays": 14,
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      }
    },
    "WorkerLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "/repurposepro/staging/worker",
        "RetentionInDays": 14,
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      }
    },
    "ApiLoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": {
          "Fn::Sub": "${NamePrefix}-api"
        },
        "Type": "application",
        "Scheme": "internet-facing",
        "IpAddressType": "ipv4",
        "Subnets": [
          {
            "Ref": "PublicSubnetA"
          },
          {
            "Ref": "PublicSubnetB"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "LoadBalancerSecurityGroup"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "600"
          },
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          },
          {
            "Key": "routing.http.xff_header_processing.mode",
            "Value": "append"
          }
        ]
      }
    },
    "ApiTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${NamePrefix}-api"
        },
        "VpcId": {
          "Ref": "VpcId"
        },
        "Protocol": "HTTP",
        "Port": 4000,
        "TargetType": "ip",
        "HealthCheckPath": "/api/v1/health/ready",
        "HealthCheckProtocol": "HTTP",
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckTimeoutSeconds": 10,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": {
          "HttpCode": "200"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ],
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "HttpsListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "ApiLoadBalancer"
        },
        "Protocol": "HTTPS",
        "Port": 443,
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "ApiTargetGroup"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      },
      "Metadata": {
        "guard": {
          "SuppressedRules": ["ELBV2_ACM_CERTIFICATE_REQUIRED"]
        },
        "Reason": "Registry rule cannot resolve parameter references. CertificateArn is constrained to an ACM ARN in account 402365884836 and Singapore; deployment verifies the certificate stack is CREATE_COMPLETE."
      }
    },
    "HttpRedirectListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "ApiLoadBalancer"
        },
        "Protocol": "HTTP",
        "Port": 80,
        "DefaultActions": [
          {
            "Type": "redirect",
            "RedirectConfig": {
              "Protocol": "HTTPS",
              "Port": "443",
              "StatusCode": "HTTP_301"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "RepurposePro"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          }
        ]
      },
      "Metadata": {
        "guard": {
          "SuppressedRules": ["ELBV2_LISTENER_SSL_POLICY_RULE"]
        },
        "Reason": "Port 80 only redirects to HTTPS 443; the HTTPS listener requires TLS 1.2 or 1.3."
      }
    },
    "ApiTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${NamePrefix}-api"
        },
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "Cpu": "256",
        "Memory": "1024",
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
