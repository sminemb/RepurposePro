# Staging runtime: copy to .env.staging, then fill every required secret.
# Full web/API/worker inventory; inject only the variables each service consumes.
# Blank database URLs must use this environment's restricted roles.
# Set REDIS_URL to the authenticated rediss:// endpoint supplied by the runtime stack.
# Both remote environments currently use Stripe sandbox keys/prices; do not switch modes here.
# NODE_ENV is production in both staging and production.
# Never load .env.database.staging or .env.deployment.staging into apps.

# Runtime
NODE_ENV=production
APP_ENV=staging
APP_URL=https://staging.re-purpose.pro
NEXT_PUBLIC_API_URL=https://api-staging.re-purpose.pro/api/v1
API_PORT=4000

# Better Auth
ADMIN_EMAIL=

# Optional read-only admin connection; configure after bootstrap provisioning.
DATABASE_ADMIN_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://staging.re-purpose.pro
BETTER_AUTH_TRUSTED_ORIGINS=https://staging.re-purpose.pro

# Transactional account email (web server only). Required in staging/production.
RESEND_API_KEY=
RESEND_FROM=

# PostgreSQL runtime only. Administration belongs in .env.database.staging.
DATABASE_URL=
DATABASE_CHECKOUT_URL=
DATABASE_WEBHOOK_URL=
DATABASE_PROCESSING_URL=
DATABASE_POOL_MAX=2
DATABASE_SSL=true

# Redis
REDIS_URL=
BULLMQ_PREFIX=repurposepro-staging

# Storage
STORAGE_DRIVER=local
STORAGE_ROOT=/mnt/repurposepro-storage/files
FILE_RETENTION_DAYS=7
CLEANUP_SCHEDULE_CRON="0 * * * *"
CLEANUP_BATCH_SIZE=100
CLEANUP_WORKER_CONCURRENCY=1
MAX_UPLOAD_BYTES=524288000
MAX_VIDEO_DURATION_SECONDS=7200

# Media tools
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_PRESET=medium
FFMPEG_CRF=20
RENDER_TIMEOUT_MS=3600000

# Whisper transcription
WHISPER_PYTHON_PATH=/opt/whisper-venv/bin/python
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_ENABLE_WORD_TIMESTAMPS=false
WHISPER_LANGUAGE=en
WHISPER_TIMEOUT_MS=900000

# Person tracking (see docs/adr/0003-person-tracking-and-caption-colors.md)
FACE_PYTHON_PATH=/opt/face-venv/bin/python
FACE_MODEL_PATH=/opt/models/blaze_face_short_range.tflite
FACE_TIMEOUT_MS=900000

# Gemini clip selection (the worker can boot without a key, but analysis will fail safely)
GEMINI_API_KEY=
GEMINI_CLIP_MODEL=gemini-3.5-flash-lite

# Optional; defaults to GEMINI_CLIP_MODEL.
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=2

# Stripe Checkout (test mode) — paste real dashboard values before starting the API.
STRIPE_SECRET_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=https://staging.re-purpose.pro/billing?checkout=success
STRIPE_CANCEL_URL=https://staging.re-purpose.pro/billing?checkout=cancelled

# Required webhook signing secret for this environment's listener/endpoint.
STRIPE_WEBHOOK_SECRET=

# Arcjet protection (LIVE required outside local development)
ARCJET_KEY=
ARCJET_MODE=LIVE
ARCJET_TIMEOUT_MS=5000
ARCJET_TRUSTED_PROXIES=172.31.0.0/16

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# Worker model cache (outside uploaded media)
HF_HOME=/mnt/repurposepro-storage/model-cache
