# Runtime
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_PORT=4000

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-development-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL runtime only. Administrative credentials belong in .env.database.
DATABASE_URL=postgresql://repurposepro_runtime:replace-with-runtime-password@localhost:5432/repurposepro
DATABASE_CHECKOUT_URL=postgresql://repurposepro_checkout:replace-with-checkout-password@localhost:5432/repurposepro
DATABASE_WEBHOOK_URL=postgresql://repurposepro_webhook:replace-with-webhook-password@localhost:5432/repurposepro
DATABASE_PROCESSING_URL=postgresql://repurposepro_processing:replace-with-processing-password@localhost:5432/repurposepro
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Redis
REDIS_URL=redis://:replace-with-redis-password@localhost:6379
BULLMQ_PREFIX=repurposepro

# Storage
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
FILE_RETENTION_DAYS=7
CLEANUP_SCHEDULE_CRON="0 * * * *"
CLEANUP_BATCH_SIZE=100
CLEANUP_WORKER_CONCURRENCY=1
MAX_UPLOAD_BYTES=524288000
MAX_VIDEO_DURATION_SECONDS=1800

# Media tools
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_PRESET=medium
FFMPEG_CRF=20
RENDER_TIMEOUT_MS=3600000
# Optional override for the bundled, hash-verified Inter 4.1 Black font
# RENDER_FONT_PATH=packages/shared/assets/fonts/Inter-Black.ttf

# Local Whisper runtime (create this isolated Python 3.13 environment during setup)
# POSIX: .venv/whisper/bin/python
WHISPER_PYTHON_PATH=.venv/whisper/Scripts/python.exe
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_ENABLE_WORD_TIMESTAMPS=false
WHISPER_LANGUAGE=en
WHISPER_TIMEOUT_MS=900000

# Local person tracking (see docs/adr/0003-person-tracking-and-caption-colors.md)
# POSIX: .venv/framing/bin/python
FACE_PYTHON_PATH=.venv/framing/Scripts/python.exe
FACE_MODEL_PATH=storage/models/blaze_face_short_range.tflite
FACE_TIMEOUT_MS=900000

# Gemini clip selection (the worker can boot without a key, but analysis will fail safely)
GEMINI_API_KEY=
GEMINI_CLIP_MODEL=gemini-3.5-flash-lite
# Optional; defaults to GEMINI_CLIP_MODEL.
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=2

# Stripe Checkout (test mode) — paste real dashboard values before starting the API.
STRIPE_SECRET_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled
# Needed when VS3-T4 webhook verification is enabled.
STRIPE_WEBHOOK_SECRET=

# Arcjet Checkout protection (test mode) — paste the real key before starting the API.
ARCJET_KEY=
ARCJET_MODE=DRY_RUN
ARCJET_TRUSTED_PROXIES=

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
