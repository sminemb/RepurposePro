# Production database administration only: copy to .env.database.production.
# Supply explicitly to provisioning/migration tooling. Never load into apps.
# Use direct database endpoints; runtime URLs use the restricted roles below.
# DATABASE_ADMIN_URL must have no query parameters; runtime TLS uses DATABASE_SSL=true.
# Remove bootstrap access from deployment scope after provisioning.
DATABASE_BOOTSTRAP_URL=
DATABASE_MIGRATION_URL=
DATABASE_RUNTIME_URL=
DATABASE_CHECKOUT_URL=
DATABASE_WEBHOOK_URL=
DATABASE_PROCESSING_URL=
DATABASE_ADMIN_URL=
